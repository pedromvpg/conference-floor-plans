# Map-owned Supabase (empty until an existing project is authorized).
# When all three are set, the app uses Postgres + Auth and ignores Blob / .data/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Interim shared store (laptop + Vercel). Create a Blob store on the Vercel project
# including the Development environment, then: vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# CARTO basemaps (free key — required or tiles show “API KEY REQUIRED”)
# https://carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_BASEMAP_KEY=

# Bootstrap admins (comma-separated). Can sign in without an invite.
ADMIN_EMAILS=
# Optional fallback if ADMIN_EMAILS is empty
ALLOWED_EMAILS=

# Airtable — same JSON as conference-screens bitcoinAsia2026 (never commit the PAT)
# CONF_BITCOINASIA2026={"airtableToken":"pat…","sponsorsToken":"pat…","sponsorsBaseId":"app…","sponsorsTable":"tbl…","agendaBaseId":"app…","agendaTable":"tbl…","speakersBaseId":"app…","speakersTable":"tbl…","eventCode":"BHK26"}
CONF_BITCOINASIA2026=
